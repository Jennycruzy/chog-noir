[Unit]
Description=Check Chog Noir operating conditions and send alerts
After=network-online.target
[Service]
Type=oneshot
User=ubuntu
WorkingDirectory=/home/ubuntu/chog-noir-release/current
ExecStart=/usr/bin/node --import tsx workers/alerts/run.mts
TimeoutStartSec=3min
NoNewPrivileges=true
UMask=0077
