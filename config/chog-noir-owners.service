[Unit]
Description=Chog Noir finalized holder directory
After=network-online.target
Wants=network-online.target

[Service]
Type=exec
User=ubuntu
WorkingDirectory=/home/ubuntu/chog-noir-monitor
ExecStart=/usr/bin/node --import tsx scripts/owner-index.mts
Restart=on-failure
RestartSec=15
Nice=10
NoNewPrivileges=true
UMask=0077

[Install]
WantedBy=multi-user.target
