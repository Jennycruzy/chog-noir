[Unit]
Description=Chog Noir finalized sale feed
After=network-online.target
StartLimitIntervalSec=5min
StartLimitBurst=3
[Service]
Type=exec
User=ubuntu
WorkingDirectory=/home/ubuntu/chog-noir-release/current
ExecStart=/usr/bin/node --import tsx workers/siren/run.mts
Restart=on-failure
RestartSec=10
NoNewPrivileges=true
UMask=0077
[Install]
WantedBy=multi-user.target
