{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "installCommand": "true",
  "buildCommand": "true",
  "outputDirectory": "apps/web",
  "rewrites": [
    { "source": "/api/:path*", "destination": "https://chognoir.54-154-121-30.sslip.io/api/:path*" },
    { "source": "/health", "destination": "https://chognoir.54-154-121-30.sslip.io/health" },
    { "source": "/art/:file", "destination": "https://chognoir.54-154-121-30.sslip.io/art/:file" },
    { "source": "/medium/:file", "destination": "https://chognoir.54-154-121-30.sslip.io/medium/:file" },
    { "source": "/thumbs/:file", "destination": "https://chognoir.54-154-121-30.sslip.io/thumbs/:file" },
    { "source": "/(.*)", "destination": "/index.html" }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Referrer-Policy", "value": "no-referrer" },
        { "key": "Content-Security-Policy", "value": "default-src 'none'; script-src 'self'; style-src 'self' 'unsafe-inline'; font-src 'self'; img-src 'self'; connect-src 'self'; base-uri 'none'; form-action 'self'; frame-ancestors 'none'" }
      ]
    }
  ]
}
