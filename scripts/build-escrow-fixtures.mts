import {historySources} from './history-sources.mts';
import {readFile,writeFile,mkdir} from 'node:fs/promises';
import {escrowContext} from './escrow-context.mts';
import {CHOG,ESCROW,TRANSFER_TOPIC} from '../packages/core/src/chain.mts';
import {type StoredHistory} from './data-types.mts';
const history=JSON.parse(await readFile(new URL('../data/related/history.json',import.meta.url),'utf8')) as StoredHistory;
const context=await escrowContext(history.toBlockExclusive,history.data.logs);
const logs=history.data.logs.filter(log=>log.address.toLowerCase()===CHOG&&log.topics[0]===TRANSFER_TOPIC&&(log.topics[1]?.toLowerCase()==='0x'+'0'.repeat(24)+ESCROW.slice(2)||log.topics[2]?.toLowerCase()==='0x'+'0'.repeat(24)+ESCROW.slice(2)));
const txs=new Set(logs.map(log=>log.transactionHash));
const blockMap=new Map(history.data.blocks.map(block=>[block.number,block]));
const allSources=await historySources(new URL('../data/related/',import.meta.url));
const native=context.index.deals.find(deal=>deal.sold&&deal.paymentToken==='0x0000000000000000000000000000000000000000')!;
const center=blockMap.get(native.sold!.block)!;
const before=[...history.data.blocks].sort((a,b)=>b.number-a.number).find(block=>block.timestamp<center.timestamp-3600)!;
const after=[...history.data.blocks].sort((a,b)=>a.number-b.number).find(block=>block.timestamp>center.timestamp+3600)!;
if(!before||!after)throw new Error('DATA_FIXTURE: Payment-window boundary blocks missing');
const windowBlocks={center:{block:center,api:allSources.blocks[center.number]},before:{block:before,api:allSources.blocks[before.number]},after:{block:after,api:allSources.blocks[after.number]}};
const fixture={windowBlocks,fetchedAt:history.finishedAt,input:context.input,traces:context.traces,logs:history.data.logs.filter(log=>txs.has(log.transactionHash)),blocks:history.data.blocks,transactions:history.data.transactions.filter(tx=>txs.has(tx.hash))};
const directory=new URL('../packages/core/test/history/',import.meta.url);await mkdir(directory,{recursive:true});
await writeFile(new URL('escrow.json',directory),JSON.stringify(fixture)+'\n');
console.log(JSON.stringify({escrowDeals:context.index.deals.length,traces:Object.keys(context.traces).length,transfers:logs.length}));
