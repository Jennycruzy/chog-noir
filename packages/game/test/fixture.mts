import {readFile} from 'node:fs/promises';
import type {EnrichedEvent} from '../../core/src/enrich.mts';
import {buildCase,answerHash,type Metadata} from '../../cases/src/build.mts';
import {saleCandidates,type CaseRules} from '../../cases/src/select.mts';
import type {Partner} from '../src/session.mts';
const fixture=JSON.parse(await readFile(new URL('../../cases/test/fixtures/sales.json',import.meta.url),'utf8')) as {rows:EnrichedEvent[];times:[number,number][]};
const saved=JSON.parse(await readFile(new URL('../../cases/test/fixtures/metadata.json',import.meta.url),'utf8')) as Record<string,Metadata>;
const metadata=new Map(Object.entries(saved).map(([id,item])=>[Number(id),item]));
const rules=JSON.parse(await readFile(new URL('../../../config/cases.json',import.meta.url),'utf8')) as CaseRules;
const times=new Map(fixture.times),candidate=saleCandidates(fixture.rows,times,rules).at(-1)!;
export const draft=buildCase(candidate,fixture.rows,times,metadata,rules,'0x'+'ab'.repeat(32));
export const partner:Partner={tokenId:1,name:'CHOG #1',power:'XRAY',description:'Open one sealed record.'};
